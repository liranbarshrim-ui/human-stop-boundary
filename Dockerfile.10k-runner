FROM python:3.12-slim
WORKDIR /app
COPY . /app
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
# Railway webhook trigger verification
# Railway post-install webhook verification
ENV DAR_CHECKPOINT_PATH=/app/state/checkpoint.json
RUN pip install --no-cache-dir -r requirements.txt
RUN mkdir -p /app/state
CMD ["python", "tools/resumable_10k_runner.py"]
