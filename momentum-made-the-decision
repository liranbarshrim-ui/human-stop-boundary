<style>
:root{
  --bg:#080808;
  --surface:#0f0f0f;
  --gold:#c8a96e;
  --gold2:#ead9b3;
  --text:#ebe5da;
  --muted:#b8b0a4;
  --dim:#7a7570;
  --dim2:#52504c;
  --line:rgba(255,255,255,.06);
  --line2:rgba(255,255,255,.03);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;overflow-x:hidden;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:"Cormorant Garamond",Georgia,serif;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  line-height:1.8;
}
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  opacity:.028;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size:180px;
}
a{text-decoration:none;color:inherit;}

/* TOPBAR */
.topbar{
  position:fixed;top:0;left:0;right:0;height:72px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 48px;z-index:100;
  background:rgba(8,8,8,.88);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.brand{
  display:flex;align-items:center;gap:14px;
  font-family:"IBM Plex Mono",monospace;
  font-size:9.5px;letter-spacing:.32em;text-transform:uppercase;color:var(--text);
}
.brand-rule{width:32px;height:1px;background:var(--gold);}
.nav-back{
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;letter-spacing:.22em;text-transform:uppercase;
  color:var(--dim);transition:color .2s;
}
.nav-back:hover{color:var(--gold2);}

/* LAYOUT */
.page{max-width:720px;margin:0 auto;padding:0 48px;position:relative;z-index:1;}

/* HEADER */
.header{padding-top:160px;padding-bottom:80px;}
.header-tag{
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;letter-spacing:.28em;text-transform:uppercase;
  color:var(--dim);margin-bottom:32px;
  opacity:0;animation:fadeUp .6s ease forwards .1s;
}
.header h1{
  font-size:clamp(32px,6vw,80px);
  font-weight:300;line-height:1.0;
  letter-spacing:-.02em;color:var(--text);
  margin-bottom:0;
  opacity:0;animation:fadeUp .7s ease forwards .2s;
}
.header h1 em{font-style:italic;color:var(--gold2);}

/* DIVIDER */
.rule{
  height:1px;background:var(--line);
  margin:56px 0;
  opacity:0;animation:fadeUp .5s ease forwards .3s;
}

/* BODY SECTIONS */
.body-section{
  margin-bottom:48px;
  opacity:0;animation:fadeUp .7s ease forwards;
}
.body-section:nth-child(1){animation-delay:.35s;}
.body-section:nth-child(2){animation-delay:.42s;}
.body-section:nth-child(3){animation-delay:.49s;}
.body-section:nth-child(4){animation-delay:.56s;}
.body-section:nth-child(5){animation-delay:.63s;}
.body-section:nth-child(6){animation-delay:.70s;}
.body-section:nth-child(7){animation-delay:.77s;}
.body-section:nth-child(8){animation-delay:.84s;}

p{
  font-size:clamp(17px,1.6vw,21px);
  font-weight:300;line-height:1.9;
  color:#c8c2b8;margin-bottom:0;
}
p + p{margin-top:20px;}

/* STACK: list as mono lines */
.stack{
  margin:28px 0;
  border-left:1px solid var(--line2);
  padding-left:24px;
  display:flex;flex-direction:column;gap:10px;
}
.stack-line{
  font-family:"IBM Plex Mono",monospace;
  font-size:12px;font-weight:300;
  color:var(--dim);letter-spacing:.04em;line-height:1.6;
}

/* STRUCTURAL BREAK */
.break{
  margin:56px 0;
  padding:36px 0;
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
}
.break p{
  font-size:clamp(20px,3vw,36px);
  font-weight:300;font-style:italic;
  line-height:1.4;color:var(--text);
}
.break p em{font-style:normal;color:var(--gold2);}

/* INDICTMENT BLOCK */
.indictment{
  margin:48px 0;
  padding:32px 32px 32px 36px;
  border-left:2px solid var(--gold);
  background:rgba(200,169,110,.03);
}
.indictment p{
  font-size:clamp(17px,1.6vw,21px);
  font-weight:300;line-height:1.85;
  color:var(--text);
}

/* NOT LIST */
.not-list{
  margin:32px 0 8px;
  display:flex;flex-direction:column;gap:6px;
}
.not-item{
  font-family:"IBM Plex Mono",monospace;
  font-size:11px;letter-spacing:.08em;
  color:var(--dim2);
  text-decoration:line-through;
  text-decoration-color:rgba(122,117,112,.3);
}
.yes-item{
  font-family:"IBM Plex Mono",monospace;
  font-size:12px;letter-spacing:.1em;
  color:var(--gold);
  margin-top:6px;
  padding-top:12px;
  border-top:1px solid var(--line);
}

/* CLOSING */
.closing{
  padding-top:72px;
  padding-bottom:96px;
  border-top:1px solid var(--line);
  margin-top:72px;
  opacity:0;animation:fadeUp .7s ease forwards .9s;
}
.closing-line{
  font-size:clamp(22px,3.5vw,44px);
  font-weight:300;font-style:italic;
  line-height:1.15;color:var(--text);
  margin-bottom:28px;max-width:22ch;
}
.sig{
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;letter-spacing:.2em;
  text-transform:uppercase;color:var(--dim);
}

/* FOOTER */
.footer{
  position:relative;z-index:1;
  text-align:center;padding:20px;
  border-top:1px solid var(--line);
  font-family:"IBM Plex Mono",monospace;
  font-size:9px;letter-spacing:.08em;color:var(--dim2);
}
.footer a{color:var(--dim2);transition:color .2s;}
.footer a:hover{color:var(--gold);}

/* ANIMATION */
@keyframes fadeUp{
  from{opacity:0;transform:translateY(14px);}
  to{opacity:1;transform:translateY(0);}
}

/* RESPONSIVE */
@media(max-width:860px){
  .topbar{padding:0 20px;}
  .page{padding:0 20px;}
  .header{padding-top:112px;padding-bottom:56px;}
  .break{margin:40px 0;padding:28px 0;}
  .indictment{padding:24px 20px 24px 24px;}
  .closing{padding-top:56px;padding-bottom:64px;margin-top:56px;}
}
