FROM python:3.13-slim

ARG FROZEN_COMMIT=b0fc0f8f0d719e80a00b27a789ec08c8f5131a81
ENV DAR_A11_FROZEN_COMMIT=${FROZEN_COMMIT}
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends procps iproute2 util-linux git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/dar

# Source is intentionally NOT copied into the image. The auditor must mount
# a checkout/snapshot and verify it is exactly DAR_A11_FROZEN_COMMIT before use.

RUN useradd --create-home --uid 10001 --shell /bin/bash dar-auditor \
    && mkdir -p /opt/dar/audit-results /opt/dar/audit-state \
    && chown -R dar-auditor:dar-auditor /opt/dar/audit-results /opt/dar/audit-state

# Start as root so the auditor can inspect topology and create the required
# unprivileged identity. Individual attack vectors must explicitly record the
# identity under which they execute.
USER root
CMD ["bash"]
